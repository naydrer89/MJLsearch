# MJLsearch environment template. Copy to .env and adjust.
#
# Nothing here is a secret by default, but .env is gitignored, so credentials can
# be added later without leaking them.
#
# api/config.py reads every key below with the SEARCH_ prefix. The Rust binaries
# read the same values from the environment, so a container needs no extra config
# file.

# --- API ---
SEARCH_INDEX_DIR=data/index/shard-000
SEARCH_HOST=127.0.0.1
SEARCH_PORT=8000
SEARCH_LOG_LEVEL=INFO
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=100
# JSON array, e.g. ["http://localhost:3000"]. Empty disables CORS entirely,
# which is the right default for a service that is not meant to be browser-facing.
SEARCH_CORS_ORIGINS=[]

# --- Dashboard ---
SEARCH_DASHBOARD_PORT=5000
# Set to 0 to silence the start-up chime.
SEARCH_STARTUP_SOUND=1
# Records kept for the query analytics panels. Bounded on purpose: this is the
# one structure in the API that grows with traffic.
SEARCH_QUERY_LOG_SIZE=512

# --- Ranking post-processing ---
SEARCH_RANKING_ENABLED=1
SEARCH_FRESHNESS_HALF_LIFE_DAYS=30
SEARCH_MAX_PER_DOMAIN=2

# --- Crawler / indexer ---
SEARCH_ROCKSDB_DIR=data/rocksdb
SEARCH_WARC_DIR=data/warc
SEARCH_BLOOM_PATH=data/urls.bloom
# The crawler seals document segments here; the indexer drains them. Neither the
# API nor the dashboard opens this directory for writing.
SEARCH_SPOOL_DIR=data/spool
SEARCH_CRAWL_STATS=data/crawl-stats.json
SEARCH_USER_AGENT=MJLsearchBot/0.1 (+https://example.invalid/bot)
