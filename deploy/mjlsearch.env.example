# Configuration for the systemd deployment. Installed to /etc/default/mjlsearch by
# deploy/setup-server.sh -- written once, never overwritten, so edits here survive an
# update. Read by all four units; a unit may override a value for itself (the search
# page pins SEARCH_HOST=0.0.0.0 in its own unit on purpose).
#
# Nothing secret belongs in this file. Every setting here has a working default, so an
# empty file is a valid configuration; these are the ones worth knowing about. The
# authoritative list is api/config.py, where the variable name is `SEARCH_` plus the
# field name in capitals.

# --- ports ---------------------------------------------------------------------------
# The API's port. It is also the port every other service reads it from.
SEARCH_PORT=8000
# The public search page. SEARCH_UI_PORT rather than SEARCH_PORT, because the page's own
# setting is `search_port` and a variable called SEARCH_SEARCH_PORT is what it would
# otherwise have to be called.
SEARCH_UI_PORT=5001
# The operator console.
SEARCH_DASHBOARD_PORT=5000

# --- binding -------------------------------------------------------------------------
# Applies to the API and the console (both loopback, neither has authentication). The
# search page overrides this to 0.0.0.0 in its own unit.
SEARCH_HOST=127.0.0.1

# --- how the API answers -------------------------------------------------------------
# Turns itself off after a start: results per site, which is what keeps one host from
# filling a page. Raise it to 10 for a corpus that shares a single host.
# SEARCH_MAX_PER_DOMAIN=2
# Workers all mmap the same read-only index, so the page cache is shared and extra
# workers buy CPU contention rather than memory headroom. Two to four is the range.
# SEARCH_WORKERS=2
# Results kept in the engine's LRU. The one knob that trades RAM for latency.
# SEARCH_QUERY_CACHE_ENTRIES=512

# --- importance ranking --------------------------------------------------------------
# These decide whether a site's front page beats its privacy policy, and whether the
# page a query names beats a page that merely repeats the name. Worth reading in
# api/config.py before changing; each is annotated with the measurement behind it.
# SEARCH_RANK_SITE_ROOT_WEIGHT=8.0
# SEARCH_RANK_AUTHORITY_WEIGHT=2.5
# SEARCH_RANK_TITLE_WEIGHT=2.0
# SEARCH_RANK_LEGAL_PENALTY=0.3
# SEARCH_RANK_SEARCH_VIEW_PENALTY=0.3

# --- crawl units ---------------------------------------------------------------------
# Pages per slice and slices per round. A round is what mjlsearch-crawl.service runs
# before exiting and being restarted; more slices per round means fewer, larger commits
# to the index, and the growth page gets a coarser curve for it.
# PAGES_PER_SLICE=750
# SLICES=6
# RUST_LOG=info

# --- sound ---------------------------------------------------------------------------
# The start-up chime is off for the services: there is no audio device behind a unit and
# its output goes to the journal.
SEARCH_STARTUP_SOUND=0
